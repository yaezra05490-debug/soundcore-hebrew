+/// Reads bit `sub_id` of a little-endian bitfield, `None` when the field is too
+/// short to contain it.
+fn bit(bitfield: &[u8], sub_id: u8) -> Option<bool> {
+    bitfield
+        .get(usize::from(sub_id / 8))
+        .map(|byte| byte & (1 << (sub_id % 8)) != 0)
+}
+
+fn set_bit(bitfield: &mut [u8], sub_id: u8, value: bool) {
+    if value {
+        bitfield[usize::from(sub_id / 8)] |= 1 << (sub_id % 8);
+    }
