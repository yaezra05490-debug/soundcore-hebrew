+        [_, 0] => Some(D1203AutoPowerOff::TenMinutes),
+        [_, 1] => Some(D1203AutoPowerOff::TwentyMinutes),
+        [_, 2] => Some(D1203AutoPowerOff::ThirtyMinutes),
+        [_, 3] => Some(D1203AutoPowerOff::SixtyMinutes),
+        _ => None,
+    }
+}
